{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["package-lock.json", "turbo.json", ".npmrc"],
  "globalEnv": [
    "CI",
    "NODE_ENV",
    "VERCEL",
    "VERCEL_ENV",
    "VERCEL_URL",
    "VERCEL_GIT_COMMIT_SHA",
    "VERCEL_GIT_COMMIT_REF",
    "VERCEL_GIT_REPO_OWNER",
    "VERCEL_GIT_REPO_SLUG",
    "TURBO_TOKEN",
    "TURBO_TEAM"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "build/**", ".vercel/output/**"],
      "env": ["NODE_ENV", "VERCEL", "VERCEL_ENV", "VERCEL_URL", "CI"],
      "inputs": ["$TURBO_DEFAULT$", "package.json", "tsconfig.json"]
    },
    "@documenso/remix#build": {
      "dependsOn": ["^build"],
      "outputs": ["build/**", "../../api/build/**", "../../assets/**", "../../fonts/**", "../../static/**"],
      "env": ["NODE_ENV", "VERCEL", "VERCEL_ENV", "VERCEL_URL", "CI"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "package.json",
        "vite.config.ts",
        "react-router.config.ts",
        "rollup.config.mjs",
        ".bin/**"
      ]
    },
    "prebuild": {
      "cache": true,
      "dependsOn": ["^prebuild"],
      "outputs": [".prisma/**", "prisma/generated/**"],
      "inputs": ["schema.prisma", "prisma/schema.prisma", "package.json"]
    },
    "@documenso/prisma#build": {
      "cache": true,
      "dependsOn": [],
      "outputs": [".prisma/**", "generated/**"],
      "inputs": ["schema.prisma", "prisma/schema.prisma", "package.json"]
    },
    "@documenso/prisma#prebuild": {
      "cache": true,
      "dependsOn": [],
      "outputs": [".prisma/**", "generated/**"],
      "inputs": ["schema.prisma", "prisma/schema.prisma", "package.json"]
    },
    "lint": {
      "cache": true,
      "outputs": []
    },
    "lint:fix": {
      "cache": false
    },
    "typecheck": {
      "cache": true,
      "dependsOn": ["^build"],
      "outputs": []
    },
    "clean": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "dev:test": {
      "cache": false
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false
    }
  }
}
