{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 60,
      "includeFiles": "api/build/server/**"
    },
    "api/static.mjs": {
      "maxDuration": 60,
      "includeFiles": "api/build/client/**"
    }
  },
  "routes": [
    { "src": "/assets/(.*)", "dest": "/api/static" },
    { "src": "/fonts/(.*)", "dest": "/api/static" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/api" }
  ]
}
