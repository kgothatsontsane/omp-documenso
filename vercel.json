{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 60,
      "includeFiles": ["api/build/server/**", "apps/remix/public/**"]
    },
    "api/cron.mjs": {
      "maxDuration": 60,
      "includeFiles": "api/cron-build/**"
    }
  },
  "rewrites": [
    { "source": "/api/cron/sweeps", "destination": "/api/cron" },
    { "source": "/(.*)", "destination": "/api" }
  ]
}
