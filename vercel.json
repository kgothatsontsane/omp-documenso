{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 60,
      "includeFiles": "api/build/server/**"
    },
    "api/static.mjs": {
      "maxDuration": 60,
      "includeFiles": "api/build/client/**"
    }
  },
  "routes": [
    { "src": "/assets/(.*)", "dest": "/api/static" },
    { "src": "/fonts/(.*)", "dest": "/api/static" },
    { "src": "/static/(.*)", "dest": "/api/static" },
    { "src": "/favicon(.*)", "dest": "/api/static" },
    { "src": "/apple-touch-icon(.*)", "dest": "/api/static" },
    { "src": "/android-chrome(.*)", "dest": "/api/static" },
    { "src": "/opengraph-image(.*)", "dest": "/api/static" },
    { "src": "/robots.txt", "dest": "/api/static" },
    { "src": "/site.webmanifest", "dest": "/api/static" },
    { "src": "/bimi/(.*)", "dest": "/api/static" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/api" }
  ]
}