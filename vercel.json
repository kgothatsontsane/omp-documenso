{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 60,
      "includeFiles": "api/build/**"
    },
    "api/cron.mjs": {
      "maxDuration": 60,
      "includeFiles": "api/build/server/**"
    }
  },
  "rewrites": [
    { "source": "/api/cron/sweeps", "destination": "/api/cron" },
    { "source": "/(.*)", "destination": "/api" }
  ]
}
